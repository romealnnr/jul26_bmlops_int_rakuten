# --- PostgreSQL ---
POSTGRES_USER=......
POSTGRES_PASSWORD=......
POSTGRES_DB=mlops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Modèle ---
MODEL_NAME=baseline_logreg
TARGET_COLUMN=target
TEST_SIZE=0.2
RANDOM_STATE=42

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Key for the admin endpoints /training, /training/trigger and /drift/compute (sent as X-API-Key).
# Required: without it those endpoints answer 503. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=......
# Password that unlocks the Retrain / Compute drift forms in Streamlit (empty: forms hidden).
STREAMLIT_ADMIN_PASSWORD=......

# --- MLflow ---
MLFLOW_TRACKING_URI=postgresql+psycopg://"POSTGRES_USER":"POSTGRES_PASSWORD"@localhost:5432/mlops   # replace "POSTGRES_PASSWORD" and "POSTGRES_PASSWORD"
MLFLOW_EXPERIMENT_NAME=rakuten-baseline-v2
MLFLOW_REGISTERED_MODEL_NAME=rakuten_baseline
# MLflow UI (docker compose service mlflow-ui) has no login and can move @champion:
# keep it on 127.0.0.1. 0.0.0.0 opens port 5000 to the network.
MLFLOW_BIND_ADDRESS=127.0.0.1

# --- Promotion gate (optional, defaults shown) ---
# A new model gets @champion only if, on test rows the champion never trained on,
# the 95% bootstrap interval of the weighted-F1 gain is above 0 and the gain is at
# least PROMOTION_MIN_GAIN. An invalid value makes /training answer 500 at once.
# PROMOTION_MIN_GAIN=0.005
# PROMOTION_BOOTSTRAP=1000
# PROMOTION_BOOTSTRAP_SEED=42
# Floor for the very first model (no @champion yet)
# PROMOTION_FIRST_MIN_F1=0.2
# Fewest unseen paired rows a decision may rest on
# PROMOTION_MIN_ROWS=100

# --- Airflow ---
AIRFLOW_UID=1000
AIRFLOW_FERNET_KEY=...
AIRFLOW_JWT_SECRET=...
# Airflow web login (http://localhost:8081)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=......

# --- Grafana ---
# Required: docker compose refuses to start without it (no admin/admin fallback).
GRAFANA_ADMIN_PASSWORD=......
# Grafana lets anonymous viewers read the dashboards: keep it on 127.0.0.1.
GRAFANA_BIND_ADDRESS=127.0.0.1
